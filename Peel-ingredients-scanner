<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peel — Ingredient Safety Scanner</title>
  <meta name="description" content="Scan food and cosmetic labels instantly. EU-sourced safety data. No bias, no fear-mongering. Just the science behind what's in your products." />
  <meta property="og:title" content="Peel — Ingredient Safety Scanner" />
  <meta property="og:description" content="Know what's really in your products. EU safety data. No scores. No bias. Just facts." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#EA580C" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --orange:     #EA580C;
      --orange-lt:  #FB923C;
      --orange-dim: #7C2D12;
      --ink:        #0F0A07;
      --ink-mid:    #3D2B1F;
      --ink-soft:   #7A6055;
      --cream:      #FDF8F4;
      --white:      #FFFFFF;
      --green:      #16A34A;
      --red:        #DC2626;
      --amber:      #D97706;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--ink);
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
      pointer-events: none; z-index: 999;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 48px;
      backdrop-filter: blur(20px);
      background: rgba(253,248,244,0.88);
      border-bottom: 1px solid rgba(234,88,12,0.1);
    }

    .nav-logo {
      display: flex; align-items: center; gap: 10px;
      font-family: 'Syne', sans-serif;
      font-weight: 800; font-size: 22px; color: var(--ink);
      text-decoration: none;
    }

    .nav-dot {
      width: 10px; height: 10px; background: var(--orange);
      border-radius: 50%; animation: pulse 2.2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%,100% { transform: scale(1); opacity: 1; }
      50%      { transform: scale(1.5); opacity: 0.6; }
    }

    .nav-links { display: flex; gap: 10px; }

    .btn-store-sm {
      display: flex; align-items: center; gap: 7px;
      padding: 9px 18px; border-radius: 100px;
      font-size: 13px; font-weight: 500;
      text-decoration: none; transition: all 0.2s;
    }

    .btn-dark-sm  { background: var(--ink); color: white; }
    .btn-dark-sm:hover  { background: var(--orange); transform: translateY(-1px); }
    .btn-light-sm { background: white; color: var(--ink); border: 1.5px solid rgba(15,10,7,0.14); }
    .btn-light-sm:hover { border-color: var(--orange); color: var(--orange); transform: translateY(-1px); }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      padding: 140px 48px 100px;
      position: relative; overflow: hidden;
    }

    .hero-glow {
      position: absolute; top: 0; left: 50%;
      transform: translateX(-50%);
      width: 900px; height: 600px;
      background: radial-gradient(ellipse at top, rgba(234,88,12,0.13) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero-glow-2 {
      position: absolute; bottom: -100px; left: -200px;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(234,88,12,0.07), transparent 70%);
      pointer-events: none;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(234,88,12,0.07);
      border: 1px solid rgba(234,88,12,0.18);
      border-radius: 100px; padding: 6px 16px;
      font-size: 13px; font-weight: 500; color: var(--orange);
      margin-bottom: 28px;
      opacity: 0; animation: fadeUp 0.6s ease 0.1s forwards;
    }

    .eyebrow-dot { width: 6px; height: 6px; background: var(--orange); border-radius: 50%; }

    .hero-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(52px, 7vw, 96px);
      font-weight: 800; line-height: 1.0;
      color: var(--ink); margin-bottom: 12px;
      opacity: 0; animation: fadeUp 0.6s ease 0.2s forwards;
    }

    .hero-title-line2 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(52px, 7vw, 96px);
      font-weight: 800; line-height: 1.0;
      color: var(--orange); margin-bottom: 32px;
      opacity: 0; animation: fadeUp 0.6s ease 0.25s forwards;
      position: relative; display: inline-block;
    }

    .hero-sub {
      font-size: clamp(16px, 2vw, 20px);
      color: var(--ink-soft); font-weight: 300;
      line-height: 1.75; max-width: 580px;
      margin: 0 auto 48px;
      opacity: 0; animation: fadeUp 0.6s ease 0.35s forwards;
    }

    .hero-sub strong { color: var(--ink); font-weight: 500; }

    /* STORE BUTTONS */
    .store-buttons {
      display: flex; gap: 16px; flex-wrap: wrap; justify-content: center;
      margin-bottom: 56px;
      opacity: 0; animation: fadeUp 0.6s ease 0.45s forwards;
    }

    .btn-store {
      display: flex; align-items: center; gap: 12px;
      padding: 16px 28px; border-radius: 16px;
      text-decoration: none; transition: all 0.25s ease;
    }

    .btn-store-ios {
      background: var(--ink); color: white;
      border: 2px solid var(--ink);
    }

    .btn-store-ios:hover {
      background: var(--orange); border-color: var(--orange);
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(234,88,12,0.35);
    }

    .btn-store-android {
      background: white; color: var(--ink);
      border: 2px solid rgba(15,10,7,0.12);
    }

    .btn-store-android:hover {
      border-color: var(--orange); color: var(--orange);
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }

    .btn-store svg { width: 28px; height: 28px; flex-shrink: 0; }

    .btn-store-text { line-height: 1.2; text-align: left; }
    .btn-store-text small { display: block; font-size: 11px; opacity: 0.55; font-weight: 400; }
    .btn-store-text strong { font-size: 16px; font-weight: 600; }

    /* TRUST PILLS */
    .trust-row {
      display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;
      opacity: 0; animation: fadeUp 0.6s ease 0.55s forwards;
    }

    .trust-pill {
      display: flex; align-items: center; gap: 6px;
      background: white; border: 1px solid rgba(15,10,7,0.08);
      border-radius: 100px; padding: 7px 14px;
      font-size: 13px; color: var(--ink-soft); font-weight: 400;
    }

    .trust-pill-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; }

    /* INGREDIENT TAGS HERO DECORATION */
    .tags-strip {
      display: flex; gap: 10px; flex-wrap: wrap;
      justify-content: center; margin-bottom: 64px;
      opacity: 0; animation: fadeUp 0.6s ease 0.3s forwards;
    }

    .ingredient-tag {
      padding: 8px 16px; border-radius: 100px;
      font-size: 13px; font-weight: 500;
      letter-spacing: 0.2px;
    }

    .tag-danger  { background: rgba(220,38,38,0.08);  color: #B91C1C; border: 1px solid rgba(220,38,38,0.15); }
    .tag-warn    { background: rgba(217,119,6,0.08);  color: #92400E; border: 1px solid rgba(217,119,6,0.15); }
    .tag-safe    { background: rgba(22,163,74,0.08);  color: #166534; border: 1px solid rgba(22,163,74,0.15); }
    .tag-info    { background: rgba(234,88,12,0.06);  color: var(--orange-dim); border: 1px solid rgba(234,88,12,0.12); }

    /* STATS */
    .stats {
      background: var(--ink);
      padding: 48px 80px;
      display: flex; align-items: center;
      justify-content: center; gap: 0; flex-wrap: wrap;
    }

    .stat {
      text-align: center;
      padding: 0 56px;
    }

    .stat + .stat {
      border-left: 1px solid rgba(255,255,255,0.07);
    }

    .stat-num {
      font-family: 'Syne', sans-serif;
      font-size: 40px; font-weight: 800;
      color: var(--orange); line-height: 1;
    }

    .stat-label {
      font-size: 12px; color: rgba(255,255,255,0.35);
      margin-top: 6px; font-weight: 300; letter-spacing: 0.3px;
    }

    /* FEATURES */
    .section {
      padding: 120px 80px;
      max-width: 1240px; margin: 0 auto;
    }

    .section-eyebrow {
      font-size: 11px; font-weight: 600; letter-spacing: 2.5px;
      text-transform: uppercase; color: var(--orange);
      margin-bottom: 16px;
    }

    .section-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(32px, 4vw, 56px);
      font-weight: 800; line-height: 1.08;
      color: var(--ink); margin-bottom: 16px;
    }

    .section-sub {
      font-size: 17px; color: var(--ink-soft); font-weight: 300;
      line-height: 1.75; max-width: 540px; margin-bottom: 64px;
    }

    .features-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
    }

    .feature-card {
      background: white;
      border: 1px solid rgba(15,10,7,0.06);
      border-radius: 24px; padding: 36px 30px;
      transition: all 0.3s ease; position: relative; overflow: hidden;
    }

    .feature-card::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(234,88,12,0.04), transparent);
      opacity: 0; transition: opacity 0.3s;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 24px 56px rgba(15,10,7,0.09);
      border-color: rgba(234,88,12,0.18);
    }

    .feature-card:hover::after { opacity: 1; }

    .feature-icon {
      width: 52px; height: 52px; border-radius: 16px;
      background: rgba(234,88,12,0.08);
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; margin-bottom: 20px;
    }

    .feature-title {
      font-family: 'Syne', sans-serif;
      font-size: 17px; font-weight: 700;
      color: var(--ink); margin-bottom: 10px;
    }

    .feature-desc {
      font-size: 14px; color: var(--ink-soft);
      line-height: 1.75; font-weight: 300;
    }

    /* PHILOSOPHY */
    .philosophy-wrap {
      background: var(--ink);
      padding: 120px 0;
    }

    .philosophy-inner {
      max-width: 1240px; margin: 0 auto; padding: 0 80px;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 96px; align-items: start;
    }

    .philosophy .section-eyebrow { color: rgba(234,88,12,0.8); }
    .philosophy .section-title   { color: white; margin-bottom: 24px; }

    .philosophy-body {
      font-size: 16px; color: rgba(255,255,255,0.48);
      line-height: 1.85; font-weight: 300; margin-bottom: 20px;
    }

    .philosophy-body strong { color: rgba(255,255,255,0.85); font-weight: 500; }

    .philosophy-quote {
      margin-top: 36px;
      font-family: 'Syne', sans-serif;
      font-size: 20px; font-weight: 700; color: white;
      line-height: 1.45; padding: 24px 28px;
      border-left: 3px solid var(--orange);
      background: rgba(255,255,255,0.03);
      border-radius: 0 14px 14px 0;
    }

    .philosophy-quote em { color: var(--orange-lt); font-style: normal; }

    .flags-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    }

    .flag-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 18px; padding: 22px 20px;
      transition: all 0.3s;
    }

    .flag-card:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(234,88,12,0.25);
      transform: translateY(-2px);
    }

    .flag-emoji { font-size: 26px; margin-bottom: 10px; }
    .flag-name  { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: white; margin-bottom: 5px; }
    .flag-desc  { font-size: 12px; color: rgba(255,255,255,0.3); line-height: 1.6; }

    /* COMPARE */
    .compare-section { padding: 120px 80px; max-width: 1240px; margin: 0 auto; }

    .compare-table { width: 100%; border-collapse: collapse; margin-top: 56px; }

    .compare-table th {
      padding: 16px 24px; text-align: left;
      font-family: 'Syne', sans-serif; font-size: 14px;
    }

    .compare-table th:first-child { color: var(--ink-soft); font-weight: 400; font-family: 'DM Sans', sans-serif; width: 40%; }
    .compare-table th:last-child  { color: var(--ink-mid); font-weight: 500; font-family: 'DM Sans', sans-serif; }

    .th-peel {
      background: var(--orange); color: white; font-weight: 700;
      border-radius: 16px 16px 0 0;
    }

    .compare-table td {
      padding: 15px 24px; font-size: 14px; color: var(--ink-mid);
      border-bottom: 1px solid rgba(15,10,7,0.055);
    }

    .td-peel {
      background: rgba(234,88,12,0.04);
      border-bottom: 1px solid rgba(234,88,12,0.07) !important;
      font-weight: 500; color: var(--ink);
    }

    .compare-table tr:last-child .td-peel { border-radius: 0 0 16px 16px; }

    .chk { color: var(--green); font-weight: 700; }
    .crs { color: var(--red); }
    .prt { color: var(--amber); font-size: 13px; }

    /* CTA */
    .cta-wrap {
      padding: 120px 48px; text-align: center;
      position: relative; overflow: hidden;
    }

    .cta-wrap::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at center, rgba(234,88,12,0.07) 0%, transparent 68%);
      pointer-events: none;
    }

    .cta-badge {
      display: inline-block;
      background: rgba(234,88,12,0.07); border: 1px solid rgba(234,88,12,0.18);
      color: var(--orange); padding: 6px 18px; border-radius: 100px;
      font-size: 13px; font-weight: 500; margin-bottom: 28px;
    }

    .cta-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(40px, 5.5vw, 72px);
      font-weight: 800; line-height: 1.05;
      color: var(--ink); margin-bottom: 20px;
    }

    .cta-sub {
      font-size: 18px; color: var(--ink-soft); font-weight: 300;
      line-height: 1.7; max-width: 460px;
      margin: 0 auto 48px;
    }

    .cta-note { margin-top: 24px; font-size: 13px; color: var(--ink-soft); }
    .cta-note strong { color: var(--orange); }

    /* FOOTER */
    footer {
      background: var(--ink); padding: 44px 80px;
      display: flex; align-items: center;
      justify-content: space-between; flex-wrap: wrap; gap: 20px;
    }

    .footer-logo {
      font-family: 'Syne', sans-serif; font-weight: 800;
      font-size: 20px; color: white;
      display: flex; align-items: center; gap: 8px;
    }

    .footer-logo-dot { width: 8px; height: 8px; background: var(--orange); border-radius: 50%; }

    .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
    .footer-links a { font-size: 13px; color: rgba(255,255,255,0.3); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--orange); }

    .footer-copy { font-size: 12px; color: rgba(255,255,255,0.18); }

    /* RESPONSIVE */
    @media (max-width: 860px) {
      nav { padding: 14px 20px; }
      .nav-links { display: none; }

      .hero { padding: 110px 24px 80px; }

      .stats { padding: 40px 20px; gap: 28px; }
      .stat { padding: 0 20px; }
      .stat + .stat { border-left: none; border-top: 1px solid rgba(255,255,255,0.07); padding-top: 24px; }

      .section { padding: 80px 24px; }
      .features-grid { grid-template-columns: 1fr; }

      .philosophy-wrap { padding: 80px 0; }
      .philosophy-inner { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }

      .compare-section { padding: 80px 24px; }
      .compare-table th, .compare-table td { padding: 12px 12px; font-size: 12px; }

      .cta-wrap { padding: 80px 24px; }
      footer { padding: 40px 24px; flex-direction: column; text-align: center; }
      .footer-links { justify-content: center; }
    }
  </style>
</head>
